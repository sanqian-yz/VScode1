<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="UTF-8"><title>舍购商品</title><style>body{font-family:Arial;max-width:960px;margin:30px auto}article{display:inline-block;width:220px;margin:10px;padding:15px;border:1px solid #ddd;border-radius:8px}.price{color:#e44;font-weight:bold}</style></head><body><h1>舍购·校园即时零售</h1><form action="${pageContext.request.contextPath}/products"><input name="keyword" value="${param.keyword}" placeholder="搜索商品"><button>搜索</button></form><p><a href="${pageContext.request.contextPath}/login">登录</a></p><c:choose><c:when test="${empty products}"><p>暂无商品。</p></c:when><c:otherwise><c:forEach var="p" items="${products}"><article><h3><c:out value="${p.name}"/></h3><p><c:out value="${p.description}"/></p><p class="price">¥${p.price}</p><p>库存：${p.stock}</p></article></c:forEach></c:otherwise></c:choose></body></html>
