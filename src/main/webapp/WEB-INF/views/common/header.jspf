<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<header>
  <h1>舍购校园即时电商平台</h1>
  <nav>
    <a href="${pageContext.request.contextPath}/products">商品</a>
    <c:if test="${not empty sessionScope.currentUser}">
      <a href="${pageContext.request.contextPath}/cart">购物车</a>
      <a href="${pageContext.request.contextPath}/orders">我的订单</a>
      <c:if test="${sessionScope.currentUser.role eq 'ADMIN'}">
        <a href="${pageContext.request.contextPath}/admin/products">后台商品</a>
        <a href="${pageContext.request.contextPath}/admin/orders">后台订单</a>
      </c:if>
      <c:if test="${sessionScope.currentUser.role eq 'DELIVERY'}">
        <a href="${pageContext.request.contextPath}/delivery/orders">配送中心</a>
      </c:if>
      <span>欢迎，${sessionScope.currentUser.username}</span>
      <a href="${pageContext.request.contextPath}/logout">退出</a>
    </c:if>
    <c:if test="${empty sessionScope.currentUser}">
      <a href="${pageContext.request.contextPath}/login">登录</a>
      <a href="${pageContext.request.contextPath}/register">注册</a>
    </c:if>
  </nav>
  <c:if test="${not empty sessionScope.flash}">
    <p class="flash">${sessionScope.flash}</p>
    <c:remove var="flash" scope="session"/>
  </c:if>
</header>
<hr/>
